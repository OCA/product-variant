<odoo>
    <record id="product_variant_change_template_view_form" model="ir.ui.view">
        <field name="model">product.variant.change.template</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="target_tmpl_id" required="1" />
                        <field
                            name="source_tmpl_ids"
                            widget="many2many_tags"
                            invisible="not source_tmpl_ids"
                            readonly="1"
                        />
                        <field
                            name="include_archived"
                            invisible="not source_tmpl_ids"
                        />
                        <field name="product_ids" invisible="1" />
                    </group>
                    <group>
                        <field name="missing_combination_policy" />
                        <field name="source_template_policy" />
                        <field name="keep_sale_price" />
                        <field name="copy_no_variant_attributes" />
                    </group>
                </group>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0">
                        <field name="product_id" readonly="1" force_save="1" />
                        <field name="source_tmpl_id" optional="hide" />
                        <field name="source_combination" />
                        <field
                            name="value_ids"
                            widget="many2many_tags"
                            options="{'no_create': True}"
                        />
                    </list>
                </field>
                <field
                    name="attribute_default_ids"
                    nolabel="1"
                    invisible="not attribute_default_ids"
                >
                    <list editable="bottom" create="0" delete="0">
                        <field name="attribute_id" readonly="1" force_save="1" />
                        <field
                            name="value_id"
                            required="1"
                            options="{'no_create': True}"
                        />
                    </list>
                </field>
                <field name="has_errors" invisible="1" />
                <field name="preview" nolabel="1" readonly="1" />
                <footer>
                    <button
                        name="action_move"
                        string="Move Variants"
                        type="object"
                        class="btn-primary"
                        invisible="has_errors"
                        confirm="Variants will be moved and the templates adjusted. This cannot be undone automatically. Continue?"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record
        id="product_variant_change_template_action_template"
        model="ir.actions.act_window"
    >
        <field name="name">Move Variants to Template</field>
        <field name="res_model">product.variant.change.template</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template" />
        <field name="binding_view_types">list,form</field>
        <field
            name="groups_id"
            eval="[Command.set([ref('product.group_product_manager')])]"
        />
    </record>

    <record
        id="product_variant_change_template_action_product"
        model="ir.actions.act_window"
    >
        <field name="name">Move Variants to Template</field>
        <field name="res_model">product.variant.change.template</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_product" />
        <field name="binding_view_types">list,form</field>
        <field
            name="groups_id"
            eval="[Command.set([ref('product.group_product_manager')])]"
        />
    </record>
</odoo>
