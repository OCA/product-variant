#. module: product_variant_change_template
#. odoo-python
#: code:addons/product_variant_change_template/wizards/product_variant_change_template.py:0
msgid ""
"%(count)s %(model)s records of %(target)s apply to all its variants, the "
"moved ones included."
msgstr ""
"%(count)s registros de %(model)s de %(target)s se aplican a todas sus "
"variantes, incluidas las movidas."

#. module: product_variant_change_template
#. odoo-python
